# =====================================================================
# CONFIGURACIÓN DE DOCKER (plantilla)
# Copiá este archivo como ".env" en la misma carpeta y completalo.
# .env NO se sube a git: cada máquina y el servidor tienen el suyo.
# =====================================================================

# 'produccion' oculta los detalles de los errores. Para probar en tu PC
# podés poner 'desarrollo': el link para restablecer la contraseña se
# muestra en pantalla (dentro de Docker no hay servidor de correo).
NL_ENTORNO=produccion

# Puertos de esta máquina: el sitio (HTTP solo redirige a HTTPS) y phpMyAdmin.
NL_PUERTO_HTTP=8090
NL_PUERTO_HTTPS=8443
NL_PUERTO_PHPMYADMIN=8091

# Dirección del sitio, para los links que se mandan por correo.
# Tiene que usar el mismo puerto que NL_PUERTO_HTTPS.
NL_URL_PUBLICA=https://localhost:8443

# Base de datos. Las claves se fijan la PRIMERA vez que se instala la base:
# para cambiarlas después hay que borrar los datos (docker compose down -v)
# o cambiarlas con ALTER USER.
# Claves: 12 caracteres o más, solo letras, números y _ . @ % + = : -
NL_BD_NOMBRE=nextleague
NL_BD_CLAVE_ROOT=cambiar_esta_clave_root
NL_BD_CLAVE=cambiar_esta_clave_app
NL_BD_CLAVE_LECTURA=cambiar_esta_clave_lectura

# 1 = carga database/06_datos_prueba.sql en la primera instalación
NL_DATOS_PRUEBA=0
